rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ غيّر الإيميل التالي إلى إيميل حساب الأدمن الذي ستنشئه في Firebase Authentication
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ADMIN_EMAIL@example.com';
    }

    match /orders/{id} {
      // أي شخص يعرف رقم الطلب يستطيع قراءته فقط (لا يمكنه سرد كل الطلبات)
      allow get: if true;
      allow list: if isAdmin();

      // إنشاء طلب جديد بحالة "في انتظار الموافقة" فقط
      allow create: if request.resource.data.keys().hasOnly(
          ['id','name','phone','qty','total','teacher','note','status','adminNote','history','createdAt','updatedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.qty is int
        && request.resource.data.qty >= 1 && request.resource.data.qty <= 100
        && request.resource.data.total == request.resource.data.qty * 100
        && request.resource.data.history.size() == 0;

      // المستخدم يعدّل الاسم/الهاتف/المعلم/الملاحظات فقط، والأدمن يعدّل كل شيء
      allow update: if isAdmin()
        || (resource.data.status != 'delivered'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name','phone','teacher','note','history','updatedAt']));

      allow delete: if isAdmin();
    }
  }
}
