rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ غيّر الإيميل التالي إلى إيميل حساب الأدمن الذي أنشأته في Firebase Authentication
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ADMIN_EMAIL@example.com';
    }

    // المنتجات: قراءة للجميع، وتعديل للأدمن فقط
    match /products/{pid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{id} {
      // أي شخص يعرف رقم الطلب يستطيع قراءته فقط (لا يمكنه سرد كل الطلبات)
      allow get: if true;
      allow list: if isAdmin();

      // الأدمن ينشئ أي طلب، والمستخدم ينشئ طلباً بحالة "في انتظار الموافقة" وسعر المنتج الحقيقي فقط
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(
          ['id','name','phone','qty','total','unitPrice','productId','productName','teacher','note','status','adminNote','history','createdAt','updatedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.qty is int
        && request.resource.data.qty >= 1 && request.resource.data.qty <= 100
        && request.resource.data.productId is string
        && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.active == true
        && request.resource.data.unitPrice == get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.price
        && request.resource.data.productName == get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.name
        && request.resource.data.total == request.resource.data.qty * request.resource.data.unitPrice
        && request.resource.data.history.size() == 0
      );

      // المستخدم يعدّل الاسم/الهاتف/المعلم/الملاحظات فقط، والأدمن يعدّل كل شيء
      allow update: if isAdmin()
        || (resource.data.status != 'delivered'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name','phone','teacher','note','history','updatedAt']));

      allow delete: if isAdmin();
    }
  }
}
